{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RunPost",
  "version": "0.2.0",
  "identifier": "dev.runpost.desktop",
  "mainBinaryName": "runpost_app",
  "build": {
    "frontendDist": "../../../ui/dist",
    "beforeBuildCommand": "npm --prefix ../../ui run build",
    "beforeDevCommand": "npm --prefix ../../ui run dev",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "RunPost",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "appimage",
      "deb"
    ],
    "publisher": "Paul Rojas",
    "homepage": "https://github.com/paul0610/runpost",
    "copyright": "© 2026 Paul Rojas",
    "license": "AGPL-3.0-only",
    "licenseFile": "../../../LICENSE",
    "category": "DeveloperTool",
    "shortDescription": "Local HTTP client with a built-in MCP server for AI agents",
    "longDescription": "RunPost is a Postman-like HTTP client: one binary, no account, no telemetry. Its MCP server lets Claude Code, Codex and other agents run your saved requests with compact, masked output, and the Agent panel shows every call live.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
